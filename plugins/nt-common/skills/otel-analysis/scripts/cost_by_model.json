{
  "size": 0,
  "query": { "term": { "event_name": "api_request" } },
  "aggs": {
    "by_model": {
      "terms": { "field": "attributes.model.keyword", "size": 30, "order": { "total_cost": "desc" } },
      "aggs": {
        "total_cost": { "sum": { "field": "attributes.cost_usd" } },
        "total_output_tokens": { "sum": { "field": "attributes.output_tokens" } }
      }
    }
  }
}
