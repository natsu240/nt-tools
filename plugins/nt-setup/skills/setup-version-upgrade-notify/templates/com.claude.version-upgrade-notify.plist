<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.claude.version-upgrade-notify</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/.claude/scripts/version-upgrade-notify.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>__INTERVAL_SECONDS__</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/.claude/scripts/version-upgrade-notify-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.claude/scripts/version-upgrade-notify-stderr.log</string>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
