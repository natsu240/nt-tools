{
  "index_patterns": ["claude-rate-limits*"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "properties": {
        "@timestamp": { "type": "date" },
        "project": { "type": "keyword" },
        "session_id": { "type": "keyword" },
        "model": { "type": "keyword" },
        "version": { "type": "keyword" },
        "five_hour": {
          "properties": {
            "used_percentage": { "type": "float" },
            "resets_at": { "type": "date", "format": "epoch_second" }
          }
        },
        "seven_day": {
          "properties": {
            "used_percentage": { "type": "float" },
            "resets_at": { "type": "date", "format": "epoch_second" }
          }
        }
      }
    }
  }
}
