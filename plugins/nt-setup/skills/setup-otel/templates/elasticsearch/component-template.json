{
  "template": {
    "settings": {
      "analysis": {
        "analyzer": {
          "kuromoji_normalize": {
            "char_filter": ["icu_normalizer"],
            "tokenizer": "kuromoji_tokenizer",
            "filter": [
              "kuromoji_baseform",
              "kuromoji_part_of_speech",
              "cjk_width",
              "ja_stop",
              "kuromoji_stemmer",
              "lowercase"
            ]
          }
        }
      }
    },
    "mappings": {
      "dynamic_templates": [
        {
          "japanese_text": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "text",
              "analyzer": "kuromoji_normalize",
              "fields": {
                "keyword": { "type": "keyword", "ignore_above": 256 }
              }
            }
          }
        }
      ]
    }
  }
}
