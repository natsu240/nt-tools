<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.claude.nt-plugin-cache-cleanup</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__HOME__/.claude/scripts/nt-plugin-cache-cleanup.sh</string>
	</array>
	<key>StartInterval</key>
	<integer>86400</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/.claude/scripts/nt-plugin-cache-cleanup-stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.claude/scripts/nt-plugin-cache-cleanup-stderr.log</string>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
